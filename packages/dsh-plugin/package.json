{
  "name": "@ai-token-report/dsh-plugin",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "DSH 插件：实时上报 token 用量 + 在 DSH 界面里直接看本机用量",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "bun run build:host && bun run build:client",
    "build:host": "bun run scripts/build-host.ts",
    "build:client": "bun run build-client.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "bun test",
    "build:npm": "bun run scripts/build-npm.ts",
    "verify:npm": "bun run verify/verify-npm-package.ts",
    "repair:profile": "bun run scripts/repair-profile.ts",
    "verify": "bun run verify/verify-plugin.ts"
  },
  "dependencies": {
    "@ai-token-report/core": "workspace:*",
    "@ai-token-report/shared": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.2",
    "chart.js": "4",
    "react-day-picker": "9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.2"
  }
}
