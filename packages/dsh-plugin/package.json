{
  "name": "@ai-token-report/dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件：以 SessionTelemetryBackend 实时上报 token 用量",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outfile=lib/index.js --external '@deepseek-ai/*'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "verify": "bun run verify/verify-plugin.ts"
  },
  "dependencies": {
    "@ai-token-report/core": "workspace:*",
    "@ai-token-report/shared": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
