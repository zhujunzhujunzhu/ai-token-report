    "verify:layout": "bun run verify/verify-layout.ts"
  },
  "dependencies": {
    "@ai-token-report/shared": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}