{
  "name": "@ai-token-report/web-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地统计页面：只看本机，数据来自本地服务的 /api/local/*",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
