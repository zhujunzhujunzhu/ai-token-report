{
  "name": "@ai-token-report/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "统计内核：zstd 解码、日志扫描、聚合、时间范围、水位线、SQLite",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "verify:drivers": "bun run verify/run-driver-parity.ts",
    "verify:multi-home": "bun run verify/verify-multi-home.ts",
    "verify:codex-format": "bun run verify/verify-codex-format.ts",
    "verify:claude-code": "bun run verify/verify-claude-code-format.ts",
    "verify:trae": "bun run verify/verify-trae-format.ts",
    "verify:workbuddy": "bun run verify/verify-workbuddy-format.ts",
    "benchmark:multi-home": "bun run verify/benchmark-multi-home.ts",
    "benchmark:sources": "bun run verify/benchmark-sources.ts",
    "verify:mysql": "bun run verify/verify-mysql-dialect.ts"
  },
  "dependencies": {
    "@ai-token-report/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}