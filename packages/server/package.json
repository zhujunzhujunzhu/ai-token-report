{
  "name": "@ai-token-report/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "后端服务：上报接收 + 本地直查 API + 部门统计 API + 静态托管",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "bun run scripts/start.ts",
    "build:node": "bun run scripts/build-node.ts",
    "start:node": "node dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "verify:mysql:node": "bun run verify/verify-mysql-node.ts",
    "verify:mysql:bun-auth": "bun run verify/verify-mysql-bun-auth.ts",
    "verify:ingest": "bun run verify/verify-ingest-performance.ts",
    "verify:assistant:live": "bun --env-file=../../.env run verify/verify-assistant-live.ts",
    "verify:assistant:eval": "bun --env-file=../../.env run verify/eval-assistant.ts"
  },
  "dependencies": {
    "@ai-token-report/core": "workspace:*",
    "@ai-token-report/shared": "workspace:*",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@noble/hashes": "2.4.0",
    "fast-xml-parser": "5.11.2",
    "hono": "4.13.9",
    "image-size": "2.0.4",
    "mysql2": "3.24.4",
    "rate-limiter-flexible": "11.2.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yauzl": "3.4.0",
    "typescript": "^5.7.2"
  }
}
