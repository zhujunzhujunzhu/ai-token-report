{
  "name": "@ai-token-report/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "后端服务：上报接收 + 本地直查 API + 部门统计 API + 静态托管",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "build:node": "bun run scripts/build-node.ts",
    "start:node": "node dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "verify:mysql:node": "bun run verify/verify-mysql-node.ts"
  },
  "dependencies": {
    "@ai-token-report/core": "workspace:*",
    "@ai-token-report/shared": "workspace:*",
    "@noble/hashes": "2.4.0",
    "hono": "4.13.9",
    "mysql2": "3.24.4",
    "rate-limiter-flexible": "11.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
