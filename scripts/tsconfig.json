{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.AsyncIterable"],
    "types": ["bun", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "../packages/dsh-plugin/scripts/repair-profile.ts",
    "../packages/dsh-plugin/verify/verify-profile-boot.ts",
    "../packages/cli/verify/verify-tarball.ts"
  ]
}
